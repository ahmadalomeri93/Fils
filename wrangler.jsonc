// نشر تلقائي على Cloudflare Workers من مجلد dist (ملفات ثابتة) + صندوق استقبال الإشعارات (/api/*) + المحاسب الذكي (/api/ai/*)
// أسرار المحاسب الذكي (من لوحة Cloudflare أو wrangler secret put، لا تُكتب هنا أبداً): ANTHROPIC_API_KEY و AI_OWNER_CODE، و BRAVE_API_KEY (اختياري: بحث إنترنت مجاني للنسخة المجانية)
// مخرج لو أحد قفل الاقتران بتخمينات غلط: غيّر متغير AI_PAIR_RESET (أي نص حتى 64 حرفاً، يفك القفل فقط ولا يبطل أي رمز)، أو دوّر ANTHROPIC_API_KEY أو AI_OWNER_CODE أو AI_TOKEN_EPOCH
{
  "name": "broken-queen-f0ed",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }, { "name": "AI_GUARD", "class_name": "AiGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }, { "tag": "v2", "new_sqlite_classes": ["AiGuard"] }]
}
